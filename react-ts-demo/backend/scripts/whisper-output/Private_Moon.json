io": 1.5247524752475248, "no_speech_prob": 0.049709539860486984}, {"id": 50, "seek": 29564, "start": 311.71999999999997, "end": 317.91999999999996, "text": " 250 meters and landed in a cold crater.", "tokens": [51168, 11650, 8146, 293, 15336, 294, 257, 3554, 38981, 13, 51478], "temperature": 0.0, "avg_logprob": -0.14208385909813037, "compression_ratio": 1.5247524752475248, "no_speech_prob": 0.049709539860486984}, {"id": 51, "seek": 29564, "start": 317.91999999999996, "end": 325.36, "text": " The next day the company said the spacecraft was able to send back pictures confirming its", "tokens": [51478, 440, 958, 786, 264, 2237, 848, 264, 22910, 390, 1075, 281, 2845, 646, 5242, 42861, 1080, 51850], "temperature": 0.0, "avg_logprob": -0.14208385909813037, "compression_ratio": 1.5247524752475248, "no_speech_prob": 0.049709539860486984}, {"id": 52, "seek": 32536, "start": 325.36, "end": 330.44, "text": " position and activating a few experiments.", "tokens": [50364, 2535, 293, 42481, 257, 1326, 12050, 13, 50618], "temperature": 0.0, "avg_logprob": -0.16038778272725768, "compression_ratio": 1.4728260869565217, "no_speech_prob": 0.04932188615202904}, {"id": 53, "seek": 32536, "start": 330.44, "end": 335.52000000000004, "text": " But shortly after the lander stopped operating.", "tokens": [50618, 583, 13392, 934, 264, 2117, 260, 5936, 7447, 13, 50872], "temperature": 0.0, "avg_logprob": -0.16038778272725768, "compression_ratio": 1.4728260869565217, "no_speech_prob": 0.04932188615202904}, {"id": 54, "seek": 32536, "start": 335.52000000000004, "end": 345.0, "text": " Both Intuitive Machines and iSpace have plans for more Moon missions in the coming years.", "tokens": [50872, 6767, 5681, 48314, 12089, 1652, 293, 741, 44306, 362, 5482, 337, 544, 10714, 13744, 294, 264, 1348, 924, 13, 51346], "temperature": 0.0, "avg_logprob": -0.16038778272725768, "compression_ratio": 1.4728260869565217, "no_speech_prob": 0.04932188615202904}, {"id": 55, "seek": 32536, "start": 345.0, "end": 352.88, "text": " The companies have contracts with NASA to provide spaceflight services and carry equipment", "tokens": [51346, 440, 3431, 362, 13952, 365, 12077, 281, 2893, 1901, 43636, 3328, 293, 3985, 5927, 51740], "temperature": 0.0, "avg_logprob": -0.16038778272725768, "compression_ratio": 1.4728260869565217, "no_speech_prob": 0.04932188615202904}, {"id": 56, "seek": 35288, "start": 352.88, "end": 355.92, "text": " and supplies to the Moon.", "tokens": [50364, 293, 11768, 281, 264, 10714, 13, 50516], "temperature": 0.0, "avg_logprob": -0.13357477339487228, "compression_ratio": 1.4444444444444444, "no_speech_prob": 0.5844306945800781}, {"id": 57, "seek": 35288, "start": 355.92, "end": 360.52, "text": " Such materials are called rocket payloads.", "tokens": [50516, 9653, 5319, 366, 1219, 13012, 30918, 82, 13, 50746], "temperature": 0.0, "avg_logprob": -0.13357477339487228, "compression_ratio": 1.4444444444444444, "no_speech_prob": 0.5844306945800781}, {"id": 58, "seek": 35288, "start": 360.52, "end": 370.68, "text": " The NASA program is officially called the Commercial Lunar Payload Services CLPS program.", "tokens": [50746, 440, 12077, 1461, 307, 12053, 1219, 264, 47171, 32077, 289, 11431, 2907, 12124, 12855, 6273, 1461, 13, 51254], "temperature": 0.0, "avg_logprob": -0.13357477339487228, "compression_ratio": 1.4444444444444444, "no_speech_prob": 0.5844306945800781}, {"id": 59, "seek": 35288, "start": 370.68, "end": 377.88, "text": " It aims to turn over many of the country's major space missions to private companies", "tokens": [51254, 467, 24683, 281, 1261, 670, 867, 295, 264, 1941, 311, 2563, 1901, 13744, 281, 4551, 3431, 51614], "temperature": 0.0, "avg_logprob": -0.13357477339487228, "compression_ratio": 1.4444444444444444, "no_speech_prob": 0.5844306945800781}, {"id": 60, "seek": 35288, "start": 377.88, "end": 380.64, "text": " to reduce costs.", "tokens": [51614, 281, 5407, 5497, 13, 51752], "temperature": 0.0, "avg_logprob": -0.13357477339487228, "compression_ratio": 1.4444444444444444, "no_speech_prob": 0.5844306945800781}, {"id": 61, "seek": 38064, "start": 380.64, "end": 384.36, "text": " Commercial companies take part in the program.", "tokens": [50364, 47171, 3431, 747, 644, 294, 264, 1461, 13, 50550], "temperature": 0.0, "avg_logprob": -0.1937682969229562, "compression_ratio": 1.3818181818181818, "no_speech_prob": 0.05295548215508461}, {"id": 62, "seek": 38064, "start": 384.36, "end": 394.15999999999997, "text": " NASA says the agency aims to launch at least two private landers to the Moon each year.", "tokens": [50550, 12077, 1619, 264, 7934, 24683, 281, 4025, 412, 1935, 732, 4551, 2117, 433, 281, 264, 10714, 1184, 1064, 13, 51040], "temperature": 0.0, "avg_logprob": -0.1937682969229562, "compression_ratio": 1.3818181818181818, "no_speech_prob": 0.05295548215508461}, {"id": 63, "seek": 38064, "start": 394.15999999999997, "end": 397.8, "text": " That is because some missions will fail.", "tokens": [51040, 663, 307, 570, 512, 13744, 486, 3061, 13, 51222], "temperature": 0.0, "avg_logprob": -0.1937682969229562, "compression_ratio": 1.3818181818181818, "no_speech_prob": 0.05295548215508461}, {"id": 64, "seek": 38064, "start": 397.8, "end": 403.64, "text": " The Space Agency's top science officer is Nikki Fox.", "tokens": [51222, 440, 8705, 21649, 311, 1192, 3497, 8456, 307, 37907, 11388, 13, 51514], "temperature": 0.0, "avg_logprob": -0.1937682969229562, "compression_ratio": 1.3818181818181818, "no_speech_prob": 0.05295548215508461}, {"id": 65, "seek": 40364, "start": 403.64, "end": 410.88, "text": " She recently told the Associated Press, the missions open up a whole new way for us to", "tokens": [50364, 1240, 3938, 1907, 264, 8619, 770, 6776, 11, 264, 13744, 1269, 493, 257, 1379, 777, 636, 337, 505, 281, 50726], "temperature": 0.0, "avg_logprob": -0.1990963075219131, "compression_ratio": 1.2203389830508475, "no_speech_prob": 0.8273035287857056}, {"id": 66, "seek": 40364, "start": 410.88, "end": 416.12, "text": " get more science to space and to the Moon.", "tokens": [50726, 483, 544, 3497, 281, 1901, 293, 281, 264, 10714, 13, 50988], "temperature": 0.0, "avg_logprob": -0.1990963075219131, "compression_ratio": 1.2203389830508475, "no_speech_prob": 0.8273035287857056}, {"id": 67, "seek": 40364, "start": 416.12, "end": 418.28, "text": " I'm Brian Lin.", "tokens": [50988, 286, 478, 10765, 9355, 13, 51096], "temperature": 0.0, "avg_logprob": -0.1990963075219131, "compression_ratio": 1.2203389830508475, "no_speech_prob": 0.8273035287857056}], "language": "en"}
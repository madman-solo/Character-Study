, 787, 1778, 415, 5965, 12678, 281, 3847, 13, 51172], "temperature": 0.0, "avg_logprob": -0.0665407703347402, "compression_ratio": 1.5433526011560694, "no_speech_prob": 0.00813272688537836}, {"id": 40, "seek": 21920, "start": 235.35999999999999, "end": 241.92, "text": " I've trained in many places in the USA and Europe, he said.", "tokens": [51172, 286, 600, 8895, 294, 867, 3190, 294, 264, 10827, 293, 3315, 11, 415, 848, 13, 51500], "temperature": 0.0, "avg_logprob": -0.0665407703347402, "compression_ratio": 1.5433526011560694, "no_speech_prob": 0.00813272688537836}, {"id": 41, "seek": 21920, "start": 241.92, "end": 246.95999999999998, "text": " Organizing a training partner in Europe is not easy,", "tokens": [51500, 12538, 3319, 257, 3097, 4975, 294, 3315, 307, 406, 1858, 11, 51752], "temperature": 0.0, "avg_logprob": -0.0665407703347402, "compression_ratio": 1.5433526011560694, "no_speech_prob": 0.00813272688537836}, {"id": 42, "seek": 24696, "start": 247.04000000000002, "end": 252.16, "text": " but in Eaton, the home of champions, wherever you go,", "tokens": [50368, 457, 294, 14429, 266, 11, 264, 1280, 295, 11230, 11, 8660, 291, 352, 11, 50624], "temperature": 0.0, "avg_logprob": -0.12597996479756124, "compression_ratio": 1.391304347826087, "no_speech_prob": 0.002442278666421771}, {"id": 43, "seek": 24696, "start": 252.16, "end": 257.68, "text": " you find a lot of athletes who can train with you.", "tokens": [50624, 291, 915, 257, 688, 295, 13820, 567, 393, 3847, 365, 291, 13, 50900], "temperature": 0.0, "avg_logprob": -0.12597996479756124, "compression_ratio": 1.391304347826087, "no_speech_prob": 0.002442278666421771}, {"id": 44, "seek": 24696, "start": 257.68, "end": 264.64, "text": " Jean-Paul Forrier opened the Kirio View Hotel in 2002,", "tokens": [50900, 13854, 12, 26434, 1171, 7326, 5625, 264, 11305, 1004, 13909, 20354, 294, 17822, 11, 51248], "temperature": 0.0, "avg_logprob": -0.12597996479756124, "compression_ratio": 1.391304347826087, "no_speech_prob": 0.002442278666421771}, {"id": 45, "seek": 24696, "start": 264.64, "end": 268.8, "text": " with just a few rooms at first.", "tokens": [51248, 365, 445, 257, 1326, 9396, 412, 700, 13, 51456], "temperature": 0.0, "avg_logprob": -0.12597996479756124, "compression_ratio": 1.391304347826087, "no_speech_prob": 0.002442278666421771}, {"id": 46, "seek": 24696, "start": 268.8, "end": 276.48, "text": " It now holds as many as 50 guests and includes a fitness center.", "tokens": [51456, 467, 586, 9190, 382, 867, 382, 2625, 9804, 293, 5974, 257, 15303, 3056, 13, 51840], "temperature": 0.0, "avg_logprob": -0.12597996479756124, "compression_ratio": 1.391304347826087, "no_speech_prob": 0.002442278666421771}, {"id": 47, "seek": 27648, "start": 276.48, "end": 283.76, "text": " I made a small investment and it has really grown, Forrier said.", "tokens": [50364, 286, 1027, 257, 1359, 6078, 293, 309, 575, 534, 7709, 11, 1171, 7326, 848, 13, 50728], "temperature": 0.0, "avg_logprob": -0.09639253218968709, "compression_ratio": 1.3379310344827586, "no_speech_prob": 0.00039281381759792566}, {"id": 48, "seek": 27648, "start": 283.76, "end": 289.76, "text": " The main training season goes from April to September.", "tokens": [50728, 440, 2135, 3097, 3196, 1709, 490, 6929, 281, 7216, 13, 51028], "temperature": 0.0, "avg_logprob": -0.09639253218968709, "compression_ratio": 1.3379310344827586, "no_speech_prob": 0.00039281381759792566}, {"id": 49, "seek": 27648, "start": 289.76, "end": 297.36, "text": " One man here still remembers what Eaton was like before all this happened.", "tokens": [51028, 1485, 587, 510, 920, 26228, 437, 14429, 266, 390, 411, 949, 439, 341, 2011, 13, 51408], "temperature": 0.0, "avg_logprob": -0.09639253218968709, "compression_ratio": 1.3379310344827586, "no_speech_prob": 0.00039281381759792566}, {"id": 50, "seek": 29736, "start": 297.36, "end": 301.28000000000003, "text": " His name is Brother Kolm O'Connell.", "tokens": [50364, 2812, 1315, 307, 8904, 26137, 76, 422, 6, 37335, 13, 50560], "temperature": 0.0, "avg_logprob": -0.19648822985197367, "compression_ratio": 1.3404255319148937, "no_speech_prob": 0.7598675489425659}, {"id": 51, "seek": 29736, "start": 301.28000000000003, "end": 306.88, "text": " He is a former leader of St. Patrick's High School.", "tokens": [50560, 634, 307, 257, 5819, 5263, 295, 745, 13, 13980, 311, 5229, 5070, 13, 50840], "temperature": 0.0, "avg_logprob": -0.19648822985197367, "compression_ratio": 1.3404255319148937, "no_speech_prob": 0.7598675489425659}, {"id": 52, "seek": 29736, "start": 306.88, "end": 310.72, "text": " Several champion runners attended the school,", "tokens": [50840, 22246, 10971, 33892, 15990, 264, 1395, 11, 51032], "temperature": 0.0, "avg_logprob": -0.19648822985197367, "compression_ratio": 1.3404255319148937, "no_speech_prob": 0.7598675489425659}, {"id": 53, "seek": 29736, "start": 310.72, "end": 319.76, "text": " including Rudisha, Vivian Chariot, Matthew Berere, and Bremen Capruto.", "tokens": [51032, 3009, 18636, 16546, 11, 28188, 952, 761, 3504, 310, 11, 12434, 5637, 323, 11, 293, 7090, 2558, 8363, 81, 8262, 13, 51484], "temperature": 0.0, "avg_logprob": -0.19648822985197367, "compression_ratio": 1.3404255319148937, "no_speech_prob": 0.7598675489425659}, {"id": 54, "seek": 29736, "start": 319.76, "end": 326.16, "text": " O'Connell first came to Eaton to teach in 1976.", "tokens": [51484, 422, 6, 37335, 700, 1361, 281, 14429, 266, 281, 2924, 294, 33978, 13, 51804], "temperature": 0.0, "avg_logprob": -0.19648822985197367, "compression_ratio": 1.3404255319148937, "no_speech_prob": 0.7598675489425659}, {"id": 55, "seek": 32616, "start": 326.16, "end": 335.20000000000005, "text": " He says that back then the town was just a few houses and St. Patrick's School.", "tokens": [50364, 634, 1619, 300, 646, 550, 264, 3954, 390, 445, 257, 1326, 8078, 293, 745, 13, 13980, 311, 5070, 13, 50816], "temperature": 0.0, "avg_logprob": -0.08787785310011643, "compression_ratio": 1.404494382022472, "no_speech_prob": 0.0008291843696497381}, {"id": 56, "seek": 32616, "start": 335.20000000000005, "end": 340.96000000000004, "text": " That was really the starting point of what Eaton eventually became.", "tokens": [50816, 663, 390, 534, 264, 2891, 935, 295, 437, 14429, 266, 4728, 3062, 13, 51104], "temperature": 0.0, "avg_logprob": -0.08787785310011643, "compression_ratio": 1.404494382022472, "no_speech_prob": 0.0008291843696497381}, {"id": 57, "seek": 32616, "start": 340.96000000000004, "end": 344.8, "text": " What we see today, O'Connell said.", "tokens": [51104, 708, 321, 536, 965, 11, 422, 6, 37335, 848, 13, 51296], "temperature": 0.0, "avg_logprob": -0.08787785310011643, "compression_ratio": 1.404494382022472, "no_speech_prob": 0.0008291843696497381}, {"id": 58, "seek": 32616, "start": 344.8, "end": 352.24, "text": " Its huge change began when the sport became professional, he added.", "tokens": [51296, 6953, 2603, 1319, 4283, 562, 264, 7282, 3062, 4843, 11, 415, 3869, 13, 51668], "temperature": 0.0, "avg_logprob": -0.08787785310011643, "compression_ratio": 1.404494382022472, "no_speech_prob": 0.0008291843696497381}, {"id": 59, "seek": 35224, "start": 352.24, "end": 357.68, "text": " Before that, athletes were confined to their place of work.", "tokens": [50364, 4546, 300, 11, 13820, 645, 31745, 281, 641, 1081, 295, 589, 13, 50636], "temperature": 0.0, "avg_logprob": -0.0893165561514841, "compression_ratio": 1.5210526315789474, "no_speech_prob": 0.02446615695953369}, {"id": 60, "seek": 35224, "start": 357.68, "end": 365.04, "text": " But when professionalism came in, athletes could now sit down with their managers", "tokens": [50636, 583, 562, 4843, 1434, 1361, 294, 11, 13820, 727, 586, 1394, 760, 365, 641, 14084, 51004], "temperature": 0.0, "avg_logprob": -0.0893165561514841, "compression_ratio": 1.5210526315789474, "no_speech_prob": 0.02446615695953369}, {"id": 61, "seek": 35224, "start": 365.04, "end": 374.40000000000003, "text": " and with shoe companies and decide, no, I can become a full-time career athlete.", "tokens": [51004, 293, 365, 12796, 3431, 293, 4536, 11, 572, 11, 286, 393, 1813, 257, 1577, 12, 3766, 3988, 18002, 13, 51472], "temperature": 0.0, "avg_logprob": -0.0893165561514841, "compression_ratio": 1.5210526315789474, "no_speech_prob": 0.02446615695953369}, {"id": 62, "seek": 35224, "start": 374.40000000000003, "end": 380.56, "text": " O'Connell went on to reform the athletics program at St. Patrick's", "tokens": [51472, 422, 6, 37335, 1437, 322, 281, 8290, 264, 37964, 1461, 412, 745, 13, 13980, 311, 51780], "temperature": 0.0, "avg_logprob": -0.0893165561514841, "compression_ratio": 1.5210526315789474, "no_speech_prob": 0.02446615695953369}, {"id": 63, "seek": 38056, "start": 380.56, "end": 387.04, "text": " and 25 of his students became world champions.", "tokens": [50364, 293, 3552, 295, 702, 1731, 3062, 1002, 11230, 13, 50688], "temperature": 0.0, "avg_logprob": -0.08041059970855713, "compression_ratio": 1.4709677419354839, "no_speech_prob": 0.0014370768330991268}, {"id": 64, "seek": 38056, "start": 387.04, "end": 393.76, "text": " Some of them came back to run their own athletics programs.", "tokens": [50688, 2188, 295, 552, 1361, 646, 281, 1190, 641, 1065, 37964, 4268, 13, 51024], "temperature": 0.0, "avg_logprob": -0.08041059970855713, "compression_ratio": 1.4709677419354839, "no_speech_prob": 0.0014370768330991268}, {"id": 65, "seek": 38056, "start": 393.76, "end": 397.84000000000003, "text": " The town around the school expanded fast", "tokens": [51024, 440, 3954, 926, 264, 1395, 14342, 2370, 51228], "temperature": 0.0, "avg_logprob": -0.08041059970855713, "compression_ratio": 1.4709677419354839, "no_speech_prob": 0.0014370768330991268}, {"id": 66, "seek": 38056, "start": 397.84000000000003, "end": 405.44, "text": " as runners from all over the world discovered the training possibilities it had.", "tokens": [51228, 382, 33892, 490, 439, 670, 264, 1002, 6941, 264, 3097, 12178, 309, 632, 13, 51608], "temperature": 0.0, "avg_logprob": -0.08041059970855713, "compression_ratio": 1.4709677419354839, "no_speech_prob": 0.0014370768330991268}, {"id": 67, "seek": 40544, "start": 405.52, "end": 412.16, "text": " O'Connell estimates there are around 500 visiting runners in the town", "tokens": [50368, 422, 6, 37335, 20561, 456, 366, 926, 5923, 11700, 33892, 294, 264, 3954, 50700], "temperature": 0.0, "avg_logprob": -0.08399028363435165, "compression_ratio": 1.541899441340782, "no_speech_prob": 0.031430091708898544}, {"id": 68, "seek": 40544, "start": 412.16, "end": 417.36, "text": " at any one time throughout the main season.", "tokens": [50700, 412, 604, 472, 565, 3710, 264, 2135, 3196, 13, 50960], "temperature": 0.0, "avg_logprob": -0.08399028363435165, "compression_ratio": 1.541899441340782, "no_speech_prob": 0.031430091708898544}, {"id": 69, "seek": 40544, "start": 417.36, "end": 422.24, "text": " We see fun runners, we have runners with personal goals,", "tokens": [50960, 492, 536, 1019, 33892, 11, 321, 362, 33892, 365, 2973, 5493, 11, 51204], "temperature": 0.0, "avg_logprob": -0.08399028363435165, "compression_ratio": 1.541899441340782, "no_speech_prob": 0.031430091708898544}, {"id": 70, "seek": 40544, "start": 422.24, "end": 427.52, "text": " we have people running a marathon to fundraise, he said.", "tokens": [51204, 321, 362, 561, 2614, 257, 27601, 281, 24844, 908, 11, 415, 848, 13, 51468], "temperature": 0.0, "avg_logprob": -0.08399028363435165, "compression_ratio": 1.541899441340782, "no_speech_prob": 0.031430091708898544}, {"id": 71, "seek": 40544, "start": 427.52, "end": 432.08, "text": " In other words, running is a sport for everybody", "tokens": [51468, 682, 661, 2283, 11, 2614, 307, 257, 7282, 337, 2201, 51696], "temperature": 0.0, "avg_logprob": -0.08399028363435165, "compression_ratio": 1.541899441340782, "no_speech_prob": 0.031430091708898544}, {"id": 72, "seek": 43208, "start": 432.08, "end": 437.03999999999996, "text": " and it has something to offer everybody.", "tokens": [50364, 293, 309, 575, 746, 281, 2626, 2201, 13, 50612], "temperature": 0.0, "avg_logprob": -0.28639381810238485, "compression_ratio": 0.8923076923076924, "no_speech_prob": 0.021441824734210968}, {"id": 73, "seek": 43208, "start": 437.03999999999996, "end": 440.08, "text": " I'm Katie Weaver.", "tokens": [50612, 286, 478, 19602, 492, 20655, 13, 50764], "temperature": 0.0, "avg_logprob": -0.28639381810238485, "compression_ratio": 0.8923076923076924, "no_speech_prob": 0.021441824734210968}], "language": "en"}